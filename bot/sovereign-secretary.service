# Biu Wui circle secretary (user unit). Install:
#   ln -sf ~/projects/biuwui/bot/biuwui-secretary.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now biuwui-secretary
[Unit]
Description=Biu Wui circle secretary (keeps circles on QDay Aevum testnet moving)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/projects/biuwui
ExecStart=%h/.nvm/versions/node/v24.14.1/bin/node --import tsx bot/secretary.ts
Environment=PATH=%h/.nvm/versions/node/v24.14.1/bin:/usr/bin:/bin
Environment=TICK_MS=8000
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
