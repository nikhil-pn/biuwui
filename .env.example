# Sovereign environment variables. Copy to .env (git-ignored) and fill in; never commit real keys.
# The relayer and faucet are serverless functions (api/); on Vercel set these in the project settings.
# Locally, scripts/serve-app.ts, the bot and the scripts read them from the shell environment.

# --- api/relay.ts, api/health.ts: the gasless relayer ----------------------------------------
# A key that holds only tQDAY (gas). It submits members' signatures and can't move their money.
RELAYER_PRIVATE_KEY=
# Daily gas budget for the relayer, in wei (default 50000000000000000 = 0.05 tQDAY). In memory, per instance.
RELAY_DAILY_GAS_CAP_WEI=50000000000000000

# --- api/faucet.ts, api/health.ts: the starter faucet ----------------------------------------
# A key holding tUSD8; it sends 0.03 tUSD8 once per address.
FAUCET_PRIVATE_KEY=

# --- api/lib/shared.ts: rate limits ----------------------------------------------------------
# Header holding the caller's IP. Vercel sets x-vercel-forwarded-for (the default). Behind another proxy,
# name the header that proxy sets; x-forwarded-for is the fallback.
TRUSTED_IP_HEADER=x-vercel-forwarded-for

# --- scripts/lib/aevum.ts: every Node process (api, bot, scripts) ------------------------------
# Aevum RPC. Use http://127.0.0.1:8545 for a local anvil fork. (The browser bundles always read the public RPC,
# except the bundle scripts/serve-app.ts builds, which uses this value.)
AEVUM_RPC=https://rpc-test.qday.info
# Use a factory you deployed yourself instead of the one in deployments/aevum.json (leave empty for that one).
SOVEREIGN_FACTORY=

# --- bot/secretary.ts and scripts/*.ts -------------------------------------------------------
# JSON file of throwaway test keys (ops, relayer, secretary, ahming, kitty, wing, siumei).
# Default ~/.config/sovereign/accounts.json. scripts/fork-setup.ts writes one for a fork.
SOVEREIGN_KEYS=
# How often the secretary bot checks every circle, in milliseconds.
TICK_MS=8000

# --- scripts/demo-circle.ts, scripts/edge-proofs.ts -------------------------------------------
# Where the proof JSON goes (default docs/proof). Use another folder on a fork so docs/proof stays the testnet record.
PROOF_DIR=
# The relayer edge-proofs step E asks (default https://app.sovereign.exprmnts.fun/api/relay).
RELAY_URL=

# --- scripts/serve-app.ts --------------------------------------------------------------------
PORT=3000
